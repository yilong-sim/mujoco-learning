<mujoco model="falling_box">
    <option timestep="0.0002" gravity="0 0 -9.81" integrator="Euler" solver="CG"/>
    
    <worldbody>
        <geom name="ground"
              type="plane"
              size="10 10 1"
              pos="0 0 0"
              quat="0.965926 0.258819 0 0"
              friction="0.5 0.0001 0.0001"/>

        <body name="box" pos="0 4 10" quat="1 0 0 0">

            <!-- This is the free joint -->
            <freejoint/>

            <geom name="box_geom"
                  type="box"
                  size="0.1 0.1 0.2"
                  mass="1"
                  friction="0.5 0.0001 0.0001"/>

        </body>
    </worldbody>
</mujoco>